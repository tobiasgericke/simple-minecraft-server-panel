# mc-panel configuration — the ONE place for all settings.
#
# Copy to /etc/mc-panel/config.env and adjust, then run install.sh.
# Read by install.sh, start.sh, mc, mc-backup (bash `source`) and by the panel
# (systemd EnvironmentFile), so keep the format simple: KEY=value or KEY="value with spaces".

# --- Minecraft server -----------------------------------------------------------------
# Display name in the panel. Empty = use the server's MOTD.
SERVER_NAME=""
MC_USER=minecraft                 # system user the server runs as (created if missing)
MC_DIR=/opt/minecraft             # server folder: server.jar, world, plugins, ...
MC_SERVICE=minecraft              # systemd unit name
MC_PORT=25565                     # used by the panel for the status ping (localhost)
JAR=server.jar

# Java: Paper 1.21.x needs Java 21+, Paper 26.x needs Java 25+
JAVA=/usr/bin/java
HEAP=2G                           # -Xms/-Xmx. Leave room for the OS and other services!
# Paper's recommended flags (https://docs.papermc.io/paper/aikars-flags)
JVM_FLAGS="-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1"

# Installed by install.sh if missing
APT_PACKAGES="openjdk-21-jre-headless zstd python3-venv"

# --- Panel ----------------------------------------------------------------------------
PANEL_USER=mcpanel
PANEL_DIR=/opt/mc-panel
# Where the panel listens. It has NO login of its own: always put a reverse proxy with
# authentication in front (see examples/Caddyfile) and never expose this port directly.
#   127.0.0.1  -> proxy runs on the host
#   172.17.0.1 -> proxy runs in Docker (docker0 bridge, use host.docker.internal there)
PANEL_HOST=127.0.0.1
PANEL_PORT=8095

# --- Backups --------------------------------------------------------------------------
# mc-backup streams a .tar.zst to stdout; nothing is stored on the server.
# Paths relative to MC_DIR, globs allowed, missing ones are skipped.
BACKUP_PATHS="world world_nether world_the_end plugins config *.yml *.json server.properties server-icon.png"
BACKUP_STATE_DIR=/var/lib/mc-backup   # remembers the last successful backup for the panel
BACKUP_WARN_HOURS=48                  # panel shows the last backup yellow after this ...
BACKUP_CRIT_HOURS=168                 # ... and red after this
